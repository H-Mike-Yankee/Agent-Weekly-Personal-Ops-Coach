# ---------------------------------------------------------------------------
# Weekly Personal Ops Coach — local configuration (never commit this, or
# any real values, to git).
#
# Copy this file to `.env` and adjust for your machine:
#   - Placeholders in `.env.example` are empty strings, never secrets.
# ---------------------------------------------------------------------------

# Local input data files (keep personal data OUT of git — see README).
JOB_APPLICATIONS_FILE=data/job_applications.csv
FLYRANK_PROGRESS_FILE=data/flyrank_progress.md
STUDY_NOTES_FILE=data/study_notes.md

# Set DRY_RUN=true to generate the report WITHOUT creating a GitHub Issue
# (safe for local testing). GitHub Actions omits DRY_RUN so it posts.
DRY_RUN=

# For GitHub Actions these are provided automatically by the workflow using
# the built-in token. For a local run that actually posts, use a fine-grained
# PAT scoped to Issues: read/write on this repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository

# DEMO_MODE=true marks the report as generated from TEST FIXTURE data
# (used by the GitHub Actions demo run, never for your personal data).
DEMO_MODE=